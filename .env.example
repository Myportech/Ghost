# Names read by ghost/core/secrets.py. Do not put real values in Git.
# Copy this file to .env locally, or set the variables in the Cursor
# environment secret store. .env is gitignored.
#
# Searched .env locations, first hit wins and does not override an
# existing process environment:
#   ~/Desktop/inline/.env
#   <repository>/.env
#   <current directory>/.env
#   ~/Library/Application Support/inline/.env
#
# On macOS, a missing variable falls through to the Keychain:
#   GROQ_API_KEY        service ghost.groq, account api_key
#   GHOST_MS_CLIENT_ID  service ghost.microsoft, account client_id
# Keychain access uses the macOS `security` command and is not available
# in Cursor Cloud.

# Model host. load_groq_api_key() reads this name. No readable module
# calls the Groq API. The expected caller was inline.py. Git stored that
# path only as a symlink to ~/Library/Application Support/inline/inline.py.
# The target was not recovered, so the symlink is no longer in the tree.
# Add the original file as a regular file. Do not commit a generated one.
# GROQ_API_KEY=

# Public Microsoft application id for the device-code flow in
# ghost/connectors/outlook/graph_client.py. No client secret is used.
# GHOST_MS_CLIENT_ID=

# Optional tenant. When unset, load_microsoft_config() uses "common".
# GHOST_MS_TENANT=

# Leave GHOST_OUTLOOK_LIVE unset. tests/test_agent_reliability.py skips
# the live Outlook send unless this value is exactly 1, and that test
# fails on purpose when it is set.
